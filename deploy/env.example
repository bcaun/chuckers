# Настройки сервера. На VPS лежат в /etc/chuckers.env (права 600, владелец root).

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-token

# Публичный адрес мини-аппа (ваш домен с HTTPS)
WEBAPP_URL=https://checkers.example.com

# short name мини-аппа из /newapp (для ссылок-приглашений t.me/<бот>/<short_name>).
# Оставьте пустым, если используете Main Mini App бота.
APP_SHORT_NAME=checkers

# Сервер слушает только локальный адрес — наружу его отдаёт Caddy
HOST=127.0.0.1
PORT=8080

# Где хранить базу и загруженные аватары
DATA_DIR=/var/lib/chuckers

# Никогда не включайте DEV=1 на боевом сервере: вход без Telegram и бесплатные покупки
DEV=0
